<div style="background-color: #f3f4f6; border-left: 4px solid #6c63ff; padding: 1em 1.5em; margin: 1.5em 0; border-radius: 8px;">
  <strong>Distinguished Paper Award: 1</strong> (NDSS 2025)
  <br>
  <strong>Top-tier/CCF-A Journal Articles: <span id="top-journal-count"></span></strong>
  <span id="top-journal-detail"></span>
  <br>
  <strong>Top-tier Security Conf Papers: <span id="security-conf-count"></span></strong>
  <span id="security-conf-detail"></span>
  <br>
  <strong>Top-tier Software Engineering/PL Conf Papers: <span id="se-pl-conf-count"></span></strong>
  <span id="se-pl-conf-detail"></span>
  <br>
  <strong>Top-tier AI/Systems/Networking Conf Papers: <span id="ai-sys-net-conf-count"></span></strong>
  <span id="ai-sys-net-conf-detail"></span>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
  function normalizeAbbr(text) {
    return text.trim().replace(/[\*\s]/g, "");
  }

  function getAbbrNode(item) {
    return item.querySelector(".abbr .badge, .abbr div, .abbr abbr");
  }

  function formatVenue(name, count) {
    return count === 1 ? name : name + " × " + count;
  }

  function renderStat(options) {
    var items = document.querySelectorAll(".publications li");
    var counts = {};

    options.venues.forEach(function (venue) {
      counts[venue.name] = 0;
    });

    items.forEach(function (item) {
      var abbrNode = getAbbrNode(item);
      if (!abbrNode) return;

      var abbrText = normalizeAbbr(abbrNode.textContent);

      options.venues.forEach(function (venue) {
        var matched = venue.variants.some(function (variant) {
          return abbrText === normalizeAbbr(variant);
        });

        if (matched) counts[venue.name]++;
      });
    });

    var total = Object.keys(counts).reduce(function (sum, venue) {
      return sum + counts[venue];
    }, 0);

    document.getElementById(options.countId).textContent = total;

    var details = options.venues
      .filter(function (venue) {
        return counts[venue.name] > 0;
      })
      .map(function (venue) {
        return formatVenue(venue.name, counts[venue.name]);
      });

    if (details.length > 0) {
      document.getElementById(options.detailId).textContent =
        " (" + details.join(", ") + ")";
    }
  }

  renderStat({
    countId: "top-journal-count",
    detailId: "top-journal-detail",
    venues: [
      { name: "TIFS", variants: ["TIFS"] },
      { name: "TDSC", variants: ["TDSC"] },
      { name: "TOSEM", variants: ["TOSEM"] },
      { name: "TSE", variants: ["TSE"] },
      { name: "TMC", variants: ["TMC"] },
      { name: "CSUR", variants: ["CSUR"] }
    ]
  });

  renderStat({
    countId: "security-conf-count",
    detailId: "security-conf-detail",
    venues: [
      { name: "S&P", variants: ["S&P", "S\\&P", "S&amp;P"] },
      { name: "USENIX Security", variants: ["USENIX Security", "USENIX"] },
      { name: "CCS", variants: ["CCS"] },
      { name: "NDSS", variants: ["NDSS"] }
    ]
  });

  renderStat({
    countId: "se-pl-conf-count",
    detailId: "se-pl-conf-detail",
    venues: [
      { name: "ICSE", variants: ["ICSE"] },
      { name: "FSE", variants: ["FSE"] },
      { name: "ASE", variants: ["ASE"] },
      { name: "ISSTA", variants: ["ISSTA"] },
      { name: "PLDI", variants: ["PLDI"] },
      { name: "OOPSLA", variants: ["OOPSLA"] }
    ]
  });

  renderStat({
    countId: "ai-sys-net-conf-count",
    detailId: "ai-sys-net-conf-detail",
    venues: [
      { name: "ICLR", variants: ["ICLR"] },
      { name: "EMNLP", variants: ["EMNLP"] },
      { name: "EuroSys", variants: ["EuroSys"] },
      { name: "USENIX ATC", variants: ["USENIX ATC"] },
      { name: "CoNEXT", variants: ["CoNEXT"] },
      { name: "INFOCOM", variants: ["INFOCOM"] }
    ]
  });
});
</script>
